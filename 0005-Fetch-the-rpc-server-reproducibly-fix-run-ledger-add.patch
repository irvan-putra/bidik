Date: Sun, 15 Nov 2026 09:15:10 +0700
Subject: [PATCH 5/7] Fetch the rpc server reproducibly; fix run ledger; add
 unpair

Build-time fetchRpcServer task downloads the pinned official 2.69.0 wheel, verifies the wheel sha256 (PyPI release metadata) and the extracted binary sha256 (THIRD-PARTY.md), and packages it via a build-dir jniLibs source set; the binary is never committed. MainActivity now uses ONE cached transport instance per pairing state so finishRun sees lastQueueId and the served/retry ledger is actually recorded (regression test: TransportIdentityTest). Paired screen gains an Unpair action with a confirmation that keeps account and captures.
---
 app/build.gradle                              | 44 +++++++++++++++++++
 .../main/java/com/vanipy/mata/MainActivity.kt | 30 ++++++++++++-
 .../com/vanipy/mata/TransportIdentityTest.kt  | 31 +++++++++++++
 3 files changed, 103 insertions(+), 2 deletions(-)
 create mode 100644 app/src/test/java/com/vanipy/mata/TransportIdentityTest.kt

diff --git a/app/build.gradle b/app/build.gradle
index 361c816..9ca36b1 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -30,6 +30,9 @@ android {
     }
     compileOptions { sourceCompatibility JavaVersion.VERSION_17; targetCompatibility JavaVersion.VERSION_17 }
     packagingOptions { jniLibs { useLegacyPackaging = true } }
+    // Generated by fetchRpcServer (see below); holds the verified
+    // arm64-v8a librpcsrv.so outside the committed tree.
+    sourceSets { main { jniLibs.srcDir("${buildDir}/rpcsrv/jniLibs") } }
 }
 
 chaquopy {
@@ -40,6 +43,47 @@ chaquopy {
     }
 }
 
+// Vendored DeltaChat rpc server, fetched at build time from the pinned
+// official wheel and hash-verified twice (wheel, then the extracted
+// binary). The binary itself is never committed to git. Provenance,
+// hashes and license: THIRD-PARTY.md. The CI emulator variant
+// (-PciEmulator) never starts the DeltaChat runtime and skips this.
+def rpcWheelFile = "${buildDir}/rpcsrv/deltachat_rpc_server-2.69.0.whl"
+def rpcLibOut = "${buildDir}/rpcsrv/jniLibs/arm64-v8a/librpcsrv.so"
+tasks.register('fetchRpcServer') {
+    onlyIf { !project.hasProperty('ciEmulator') && !file(rpcLibOut).exists() }
+    doLast {
+        def wheel = file(rpcWheelFile)
+        wheel.parentFile.mkdirs()
+        if (!wheel.exists()) {
+            new URL('https://files.pythonhosted.org/packages/50/66/7b6428ac9a4a73bfc3199a26477b2fb3d0e60d78485c1d0d0b2b755a04f8/deltachat_rpc_server-2.69.0-py3-none-android_21_arm64_v8a.whl')
+                .withInputStream { s -> wheel.newOutputStream() << s }
+        }
+        def sha = { File f ->
+            java.security.MessageDigest.getInstance('SHA-256')
+                .digest(f.bytes).encodeHex().toString()
+        }
+        // Wheel hash per the PyPI release metadata for 2.69.0.
+        if (sha(wheel) != '8951349d8805e276ac574f7588a9a23759c33bc208443eafc48ab03361bf0c54') {
+            wheel.delete()
+            throw new GradleException('rpc server wheel sha256 mismatch; deleted')
+        }
+        def zip = new java.util.zip.ZipFile(wheel)
+        def entry = zip.getEntry('deltachat_rpc_server/deltachat-rpc-server')
+        def out = file(rpcLibOut)
+        out.parentFile.mkdirs()
+        zip.getInputStream(entry).withStream { s -> out.newOutputStream() << s }
+        zip.close()
+        out.setExecutable(true)
+        // Binary hash recorded in THIRD-PARTY.md.
+        if (sha(out) != '101c7c59675f295efa601eba0e4bcf01fa2456e44b8aa9ed2fa999c6fb995257') {
+            out.delete()
+            throw new GradleException('rpc server binary sha256 mismatch; deleted')
+        }
+    }
+}
+preBuild.dependsOn 'fetchRpcServer'
+
 dependencies {
     implementation 'androidx.core:core-ktx:1.12.0'
     implementation 'androidx.appcompat:appcompat:1.6.1'
