From cd1bc2b4757cef82bb1042e9a84fef68d174fb2c Mon Sep 17 00:00:00 2001
From: irvan-putra <irvan.putra@gmail.com>
Date: Sun, 15 Nov 2026 09:36:20 +0700
Subject: [PATCH 7/7] Archive each capture run; gate pairing behind account
 creation

Each run writes captures/run-<timestamp>/ and runs are kept, never auto-deleted (they leave the phone only via the paired transport and are gone only when app data is cleared); the paired screen now states the on-open dataflow (sync queue, capture each page, send results back). Setup reflects prerequisites: step 1 creates the messaging account, pairing UI (step 2) appears only after an account is confirmed (provisioned flag set by provision/selfAddress success).
---
 .../main/java/com/vanipy/mata/MainActivity.kt | 51 +++++++++++++------
 .../java/com/vanipy/mata/SetupController.kt   |  9 ++++
 2 files changed, 45 insertions(+), 15 deletions(-)

diff --git a/app/src/main/java/com/vanipy/mata/MainActivity.kt b/app/src/main/java/com/vanipy/mata/MainActivity.kt
index 9e8f0cf..22db428 100644
--- a/app/src/main/java/com/vanipy/mata/MainActivity.kt
+++ b/app/src/main/java/com/vanipy/mata/MainActivity.kt
@@ -120,6 +120,9 @@ class MainActivity : AppCompatActivity() {
             setupBox.addView(TextView(this).apply {
                 text = "paired: ${SetupController.peerAddr(this@MainActivity)}"
             })
+            setupBox.addView(TextView(this).apply {
+                text = "on open: syncs the queue, captures each page, sends results back automatically"
+            })
             return
         }
         val state = TextView(this)
@@ -128,22 +131,35 @@ class MainActivity : AppCompatActivity() {
             val addr = SetupController.selfAddress(this@MainActivity)
             state.text = if (addr != null) "messaging address: $addr" else "messaging not set up"
         }
-        setupBox.addView(Button(this).apply {
-            text = "Create messaging account"
-            setOnClickListener { btn ->
-                btn.isEnabled = false
-                status.text = "creating messaging account..."
-                scope.launch {
-                    try {
-                        val addr = SetupController.provision(this@MainActivity, "nine.testrun.org")
-                        status.text = "account ready"
-                        state.text = "messaging address: $addr"
-                    } catch (e: Exception) {
-                        status.text = "account setup failed: ${e.message}"
-                        btn.isEnabled = true
+        if (!SetupController.isProvisioned(this)) {
+            // Pairing needs the account first: the handshake runs over
+            // the account's own transport, and the peer address comes
+            // back from it.
+            setupBox.addView(TextView(this).apply {
+                text = "step 1: create the messaging account"
+            })
+            setupBox.addView(Button(this).apply {
+                text = "Create messaging account"
+                setOnClickListener { btn ->
+                    btn.isEnabled = false
+                    status.text = "creating messaging account..."
+                    scope.launch {
+                        try {
+                            val addr = SetupController.provision(this@MainActivity, "nine.testrun.org")
+                            status.text = "account ready"
+                            state.text = "messaging address: $addr"
+                            renderSetup()
+                        } catch (e: Exception) {
+                            status.text = "account setup failed: ${e.message}"
+                            btn.isEnabled = true
+                        }
                     }
                 }
-            }
+            })
+            return
+        }
+        setupBox.addView(TextView(this).apply {
+            text = "step 2: pair with the assistant's invite QR"
         })
         setupBox.addView(Button(this).apply {
             text = "Scan pairing QR"
@@ -207,7 +223,12 @@ class MainActivity : AppCompatActivity() {
         progress.visibility = View.VISIBLE
         status.text = "running..."
         scope.launch {
-            val outDir = File(filesDir, "captures")
+            // Every run archives into its own timestamped directory.
+            // Captures are kept, never auto-deleted; they leave the
+            // phone only via the paired transport, and are gone only
+            // when the app's data is cleared.
+            val stamp = java.text.SimpleDateFormat("yyyyMMdd-HHmmss", java.util.Locale.US).format(java.util.Date())
+            val outDir = File(filesDir, "captures/run-$stamp")
             val outcome = try {
                 CaptureRunner(this@MainActivity, currentTransport(), outDir).runOnce()
             } catch (e: Exception) {
diff --git a/app/src/main/java/com/vanipy/mata/SetupController.kt b/app/src/main/java/com/vanipy/mata/SetupController.kt
index d28ade5..0fb62b1 100644
--- a/app/src/main/java/com/vanipy/mata/SetupController.kt
+++ b/app/src/main/java/com/vanipy/mata/SetupController.kt
@@ -14,6 +14,7 @@ object SetupController {
     private const val PREFS = "mata"
     private const val KEY_PEER = "peer_addr"
     private const val KEY_PAIRED = "paired"
+    private const val KEY_PROVISIONED = "provisioned"
 
     private fun prefs(context: Context) =
         context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
@@ -23,6 +24,12 @@ object SetupController {
     fun isPaired(context: Context): Boolean =
         prefs(context).getBoolean(KEY_PAIRED, false) && peerAddr(context) != null
 
+    /** Account creation gates pairing: the handshake needs the account's
+     *  own transport. The flag is set only after a provision/selfAddress
+     *  call actually confirms the account. */
+    fun isProvisioned(context: Context): Boolean =
+        prefs(context).getBoolean(KEY_PROVISIONED, false)
+
     /**
      * Pair with the assistant by completing its secure-join invite QR.
      * Chatmail requires end-to-end encryption, so a typed address can
@@ -71,6 +78,7 @@ object SetupController {
                     relay
                 )
                 .toString()
+                .also { prefs(context).edit().putBoolean(KEY_PROVISIONED, true).apply() }
         }
 
     suspend fun selfAddress(context: Context): String? = withContext(Dispatchers.IO) {
@@ -83,6 +91,7 @@ object SetupController {
                     context.filesDir.absolutePath
                 )
                 .toString()
+                .also { prefs(context).edit().putBoolean(KEY_PROVISIONED, true).apply() }
         } catch (e: Exception) {
             null
         }
