<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture support only: cleartext is permitted exclusively to
     loopback hosts so CaptureFixtureTest's in-process HTTP server can
     be loaded by the real WebView. Every other destination keeps the
     default denial. Applies to debug builds only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
