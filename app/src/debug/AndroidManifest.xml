<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: lets the instrumented fixture serve its page
     over cleartext loopback. Release builds never merge this file, so
     the release app keeps the platform default (cleartext denied) and
     the UrlGuard loopback block. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
